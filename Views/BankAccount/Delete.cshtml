@model wt_lab4_4mvc_akushevich.Models.BankAccount

<div class="container py-4">
    <div class="card shadow-sm rounded-4 border-danger" style="max-width: 500px;">
        <div class="card-body">
            <h2 class="mb-3 text-danger">Удаление счёта</h2>
            <p>Вы действительно хотите удалить следующий счёт?</p>

            <p><strong>Номер:</strong> @Model.AccountNumber</p>
            <p><strong>Владелец:</strong> @Model.OwnerName</p>
            <p><strong>Баланс:</strong> @Model.Balance.ToString("N2") BYN</p>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Удалить</button>
                <a asp-action="Index" class="btn btn-secondary">Отмена</a>
            </form>
        </div>
    </div>
</div>